# Template for the frontend's .env.local. Copy it with: cp .env.example .env.local
# Vite only exposes variables starting with VITE_ to the browser, so never put secrets here.

# Address of the CreatorOS backend (FastAPI). No trailing slash.
# Local development (same as the default when this is not set):
VITE_API_URL=http://localhost:8000
# Production: set this in the Vercel project settings to the deployed backend's address.
