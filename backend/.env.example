# Template for backend/.env. Copy it with: cp .env.example .env
# Then adjust the values for your machine. Never commit .env.
# Real environment variables take priority over values in .env.

# Name shown in the API docs.
APP_NAME="CreatorOS API"

# Either development or production.
ENVIRONMENT=development

# Frontend origins allowed to call the API from a browser, as a JSON list. No trailing slashes, no "*".
# Local development (same as the default):
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
# Production: set this on the backend hosting service instead of in a file:
# CORS_ORIGINS='["https://creatoros-lyart-zeta.vercel.app"]'
